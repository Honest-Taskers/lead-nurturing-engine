# MySQL connection URL — TiDB Cloud Serverless requires the ssl param, e.g.:
# mysql://user:pass@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/nurture_dev?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://user:password@localhost:3306/relationship_engine

# OpenAI API key for report generation — text + cover images (leave unset to use stub reports)
OPENAI_API_KEY=

# logo.dev publishable token for company logos (free at logo.dev).
# Without it logo.dev answers 401 and the UI falls back to lettermark avatars.
LOGO_DEV_TOKEN=

PORT=4000
